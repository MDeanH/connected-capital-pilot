.node-local/

# Backups
*.bak

# NOTE: do NOT add a bare `lib/` here — it would ignore netlify/functions/lib/
# (the scoring engine). Python venv libs are already covered by .venv/ above.

# Netlify CLI local state
.netlify/

# Claude Code local state (machine-specific paths)
.claude/

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Data and large files
*.log
*.xlsx
# Ignore bulk raw downloads (Zillow full metro ~4MB+, FHFA master ~17MB) and staged
